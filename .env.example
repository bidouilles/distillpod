# Podcast Index API (https://podcastindex.org/developer)
PODCAST_INDEX_API_KEY=your_key_here
PODCAST_INDEX_SECRET=your_secret_here

# Agent CLI powering every AI feature.
# "codex" (default) requires: npm i -g @openai/codex && codex login
# "claude" requires:          npm i -g @anthropic-ai/claude-code && claude login
LLM_BACKEND=codex
LLM_BIN=                       # explicit path; leave empty to resolve via PATH
LLM_MODEL=                     # passed to `codex exec -m`; empty uses the CLI default

# Storage paths
MEDIA_DIR=/path/to/distillpod/media
DB_PATH=/path/to/distillpod/distillpod.db
REPORTS_DIR=/path/to/distillpod/reports

# Public-facing domain (used for CORS, OAuth redirect, report URLs)
PUBLIC_URL=https://your-domain.example.com

# Server
FRONTEND_ORIGIN=http://localhost:5173

# Transcription backend.
# "auto" (default) prefers Voxtral when MISTRAL_API_KEY is set, then mlx where
# it is importable, then faster-whisper. It never reaches a hosted backend
# without a key.
STT_BACKEND=auto               # auto / voxtral / mlx / whisper
STT_LANGUAGE=                  # ISO code e.g. "fr"; empty = auto-detect

# Voxtral — Mistral's hosted STT. Fast (27-min episode in ~35s) and strong on
# non-English audio, but the audio leaves your server.
# Meaning-based search over transcripts. Optional: "off" keeps everything on
# this box and leaves Ask on keyword retrieval. "auto" uses mistral-embed when
# MISTRAL_API_KEY is set, which sends window text to the same API Voxtral uses;
# the first index is still a deliberate press in the app.
EMBED_BACKEND=auto

MISTRAL_API_KEY=
STT_MODEL=voxtral-mini-latest

# mlx-whisper — Apple Silicon GPU. Local like faster-whisper but ~8x faster.
#   pip install mlx-whisper      (macOS arm64 only)
MLX_MODEL_REPO=                # pin a repo; else mlx-community/whisper-$WHISPER_MODEL-mlx

# Model size, shared by the mlx and whisper backends.
WHISPER_MODEL=medium           # base / small / medium / large-v3

# faster-whisper only. CTranslate2 has no Metal backend, so on macOS this can
# only be "cpu" — use STT_BACKEND=mlx for the GPU there.
WHISPER_DEVICE=cpu             # cpu / cuda

# yt-dlp — only needed to add YouTube videos as episodes.
#   brew install yt-dlp   /   pipx install yt-dlp
YTDLP_BIN=                     # explicit path; resolved via PATH when empty

# Google OAuth — required for login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_EMAILS=yourname@gmail.com        # comma-separated; only these can log in
SESSION_SECRET=change-this-to-a-random-32-char-string

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Test mode — set true ONLY when running E2E tests locally, NEVER in prod
TEST_MODE=false

# --- Research (web search) ---
# Deep research needs this: the agent CLI is sandboxed with no network, so a
# search API is the only way to look outside the episode. Without it, research
# refuses to run rather than writing a report from no sources.
TAVILY_API_KEY=
