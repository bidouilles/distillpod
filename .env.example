# Podcast Index API (https://podcastindex.org/developer)
PODCAST_INDEX_API_KEY=your_key_here
PODCAST_INDEX_SECRET=your_secret_here

# Agent CLI powering every AI feature.
# "codex" (default) requires: npm i -g @openai/codex && codex login
# "claude" requires:          npm i -g @anthropic-ai/claude-code && claude login
LLM_BACKEND=codex
LLM_BIN=                       # explicit path; leave empty to resolve via PATH
LLM_MODEL=                     # passed to `codex exec -m`; empty uses the CLI default

# Storage paths
MEDIA_DIR=/path/to/distillpod/media
DB_PATH=/path/to/distillpod/distillpod.db
REPORTS_DIR=/path/to/distillpod/reports

# Public-facing domain (used for CORS, OAuth redirect, report URLs)
PUBLIC_URL=https://your-domain.example.com

# Server
FRONTEND_ORIGIN=http://localhost:5173

# Transcription backend.
# "auto" (default) uses Voxtral when MISTRAL_API_KEY is set, else faster-whisper.
STT_BACKEND=auto               # auto / voxtral / whisper
STT_LANGUAGE=                  # ISO code e.g. "fr"; empty = auto-detect

# Voxtral — Mistral's hosted STT. Fast (27-min episode in ~35s) and strong on
# non-English audio, but the audio leaves your server.
MISTRAL_API_KEY=
STT_MODEL=voxtral-mini-latest

# faster-whisper — local and private, but CPU-bound (10-20 min for the same
# episode). Used when STT_BACKEND=whisper or no Mistral key is set.
WHISPER_MODEL=medium           # base / small / medium / large-v3
WHISPER_DEVICE=cpu             # cpu / cuda

# Google OAuth — required for login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ALLOWED_EMAILS=yourname@gmail.com        # comma-separated; only these can log in
SESSION_SECRET=change-this-to-a-random-32-char-string

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Test mode — set true ONLY when running E2E tests locally, NEVER in prod
TEST_MODE=false
